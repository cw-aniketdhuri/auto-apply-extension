{
  "manifest_version": 3,
  "name": "AutoApply Vision Agent",
  "version": "3.0.0",
  "description": "Visual form filler powered by Gemini and Chrome Debugger",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
}